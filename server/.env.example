# Server-only credentials. Never copy service-role or grading keys into web/config.js.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
# Optional extra Gemini keys, comma separated, tried when the first is rate limited.
# Quota is per Google Cloud project, so each key must come from a different project.
GEMINI_API_KEYS=
# Exact origin of deployed static web. Leave empty for same-origin serving.
CORS_ORIGINS=
# Community rounds, shared speeches and reactions (docs/implementation/community-backend.md).
# Needs migration 0006. Auto-approve skips review: only for a demo among people who trust each other.
COMMUNITY_ENABLED=false
COMMUNITY_AUTO_APPROVE=false
# Explicit local fixture viewer; only loopback requests are accepted.
DEMO_MODE=false
# Production: put this directory on a persistent volume to preserve grading caches.
DATA_DIR=server/data
